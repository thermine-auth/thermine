# Settings for deploy/compose.yaml. Copy to deploy/.env and fill in.

# The users' site: the id app, the OAuth/OIDC provider, the issuer of every token.
PUBLIC_URL=https://id.mywebsite.com

# The staff site: the console. Must be https, so its session cookie is Secure.
ADMIN_URL=https://admin-id.mywebsite.com

# openssl rand -base64 32 — keep it forever: it unlocks the token signing keys.
XERMESS_SECRET_KEY=

# openssl rand -base64 24
POSTGRES_PASSWORD=

# Password reset emails. Without a host they are only written to the log.
XERMESS_SMTP_HOST=
XERMESS_SMTP_PORT=587
XERMESS_SMTP_USERNAME=
XERMESS_SMTP_PASSWORD=
XERMESS_SMTP_FROM=My Website <no-reply@mywebsite.com>
